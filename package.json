{
  "name": "remark-tableau",
  "version": "0.2.0",
  "description": "A remark plugin that renders Tableau (ts-tableau) fenced code blocks as HTML tables.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pragdave/remark-tableau.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "remark",
    "remark-plugin",
    "markdown",
    "tableau"
  ],
  "author": "Dave Thomas (pragdave)",
  "license": "ISC",
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "rehype-stringify": "^10.0.1",
    "remark-rehype": "^11.1.1",
    "ts-tableau": "^0.3.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.4"
  }
}
